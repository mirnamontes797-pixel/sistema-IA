# ============================================================
# Variables del API (apps/api) — configurar en Vercel:
# Project → Settings → Environment Variables (Production/Preview)
# NUNCA subir el archivo .env real a Git (está en .gitignore).
# ============================================================

# Supabase (Proyecto → Settings → API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key   # server-side, NUNCA exponer
SUPABASE_ANON_KEY=tu-anon-key                    # solo referencia local

# Firma de JWT propios de la API
JWT_SECRET=un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

BCRYPT_ROUNDS=12
API_PORT=3001
NODE_ENV=development

# Opcional en Vercel: por defecto el frontend llama a /api (same-origin)
# y el rewrite de vercel.json lo dirige al servicio api.
# NO apuntar a localhost en producción.
PUBLIC_API_URL=
