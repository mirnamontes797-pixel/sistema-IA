# ============================================================
# Variables públicas del frontend (apps/web)
# Prefijo PUBLIC_ obligatorio para que Vite las exponga al navegador.
# Configurar en Vercel: Project → Settings → Environment Variables.
# ============================================================

# Supabase Auth del lado del cliente (login con Google / PKCE)
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Opcional: dejar vacío en Vercel para usar /api same-origin.
# En local con `npm run dev` también puede quedar vacío
# (vite.config.js ya hace proxy de /api a localhost:3001).
PUBLIC_API_URL=
